{
  "schemaVersion": 1,
  "id": "caramelchat",
  "version": "${version}",

  "name": "caramelChat",
  "description": "Selects Minecraft 26.2's native Wayland input path on supported Linux Wayland sessions.",
  "authors": [
    "LemonCaramel"
  ],
  "contact": {
    "homepage": "https://caramel.moe/",
    "sources": "https://github.com/LemonCaramel/caramelChat",
    "issues": "https://github.com/LemonCaramel/caramelChat/issues"
  },

  "license": "GNU LGPL 3.0",
  "icon": "icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [ "moe.caramel.chat.fabric.MainFabric" ]
  },
  "mixins": [ "caramelchat.mixins.json" ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2"
  },
  "breaks": {
    "lunar": "*",
    "feather": "*"
  },

  "custom": {
    "modmenu": {
      "update_checker": true
    }
  }
}
